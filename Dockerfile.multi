# ==============================================================================
# EduSpark 前端多平台 Dockerfile
# ==============================================================================
# 支持平台: linux/amd64 (x86_64), linux/arm64 (Apple Silicon)
# 构建示例:
#   docker build -f Dockerfile.amd64 -t eduspark-frontend:amd64 .
#   docker build -f Dockerfile.arm64 -t eduspark-frontend:arm64 .
#   docker buildx build --platform linux/amd64,linux/arm64 -t eduspark-frontend:latest .
# ==============================================================================

# ---- 参数配置 ----
ARG TARGETPLATFORM
ARG NEXT_PUBLIC_TINYMCE_API_KEY
ARG NEXT_PUBLIC_API_BASE_URL=https://eduspark.weilanx.com/api
ARG COZE_API_KEY
ARG COZE_WORKFLOW_ID
ARG ZHIPUAI_API_KEY

# ---- Stage 1: Dependency Installation ----
FROM --platform=${TARGETPLATFORM:-linux/amd64} node:20-slim AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
RUN corepack enable && \
    corepack prepare pnpm@latest --activate && \
    pnpm install --frozen-lockfile

# ---- Stage 2: Builder ----
FROM --platform=${TARGETPLATFORM:-linux/amd64} node:20-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN corepack enable && \
    corepack prepare pnpm@latest --activate

# 注入构建时环境变量
ENV NEXT_PUBLIC_TINYMCE_API_KEY=${NEXT_PUBLIC_TINYMCE_API_KEY}
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV COZE_API_KEY=${COZE_API_KEY}
ENV COZE_WORKFLOW_ID=${COZE_WORKFLOW_ID}
ENV ZHIPUAI_API_KEY=${ZHIPUAI_API_KEY}

RUN pnpm build

# ---- Stage 3: Production Runner ----
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_BASE_URL=https://eduspark.weilanx.com/api

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "server.js"]
